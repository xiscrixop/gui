payload = payload:gsub("%s+", "")

local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local map = {}
for i = 1, #alphabet do
    map[string.byte(alphabet, i)] = i - 1
end

local state = 0x6A09E667
local function nextKey()
    state = bit32.bxor(state, bit32.lshift(state, 13))
    state = bit32.bxor(state, bit32.rshift(state, 17))
    state = bit32.bxor(state, bit32.lshift(state, 5))
    return bit32.band(state, 255)
end

local output = {}
local chunk = {}
local chunkSize = 0

local function pushByte(value)
    chunkSize += 1
    chunk[chunkSize] = string.char(bit32.bxor(value, nextKey()))
    if chunkSize >= 4096 then
        output[#output + 1] = table.concat(chunk)
        table.clear(chunk)
        chunkSize = 0
    end
